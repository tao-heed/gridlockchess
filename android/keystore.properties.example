# Release signing credentials for the Android build (TEMPLATE — safe to commit).
#
# Setup:
#   1. Generate a keystore. KEEP THE .jks FILE OUTSIDE THIS REPO and BACK IT UP SECURELY —
#      if you lose this key you can NEVER push an update to the same Google Play listing again:
#
#        keytool -genkey -v -keystore gridlock-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias gridlock
#
#   2. Copy this file to  android/keystore.properties  and fill in the real values below.
#   3. android/keystore.properties, *.jks and *.keystore are gitignored — never commit them.
#
# build.gradle reads these keys; storeFile may be an absolute path or relative to android/.

storeFile=C:/absolute/path/to/gridlock-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=gridlock
keyPassword=YOUR_KEY_PASSWORD
