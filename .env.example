# .env.example — copy to .env on the VM and fill in. Do NOT commit the real .env.

# Public domain Caddy will obtain TLS for. Its DNS A record must point at this VM.
SITE_ADDRESS=chess.example.com

# Direct URL to the Fairy-Stockfish Linux binary MATCHING THIS VM'S ARCH.
# Oracle Ampere A1 = arm64/aarch64. Use a "largeboard" build to match local dev.
# Get the exact asset name from: https://github.com/fairy-stockfish/Fairy-Stockfish/releases/latest
# If the asset is zipped, unzip and host/point at the raw executable.
FSF_URL=https://github.com/fairy-stockfish/Fairy-Stockfish/releases/download/CHANGE_ME/fairy-stockfish-largeboard_CHANGE_ME

# Engine tuning. Keep POOL_SIZE * THREADS within the VM core count.
# Oracle Always Free ARM = up to 4 cores → e.g. pool 2 x threads 2.
ENGINE_POOL_SIZE=2
ENGINE_THREADS=2
ENGINE_HASH=256

# Comma-separated allowed BROWSER origins. Leave empty to allow all (the native
# app sends no Origin header and always passes; this only restricts web browsers).
# For a Capacitor Android build the webview origin is typically https://localhost.
ALLOWED_ORIGINS=

# Per-IP requests per minute on /api/evaluate.
RATE_LIMIT_MAX=60

# Firebase — Realtime Database + Anonymous Auth (Uplink online PvP).
# Values come from Firebase console → Project Settings → Your apps → Web app.
# These are safe to bundle in the JS build; security is enforced by Firebase Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
