{
  "name": "gridlock-chess",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server.js",
    "dev:all": "concurrently -n ui,engine -c cyan,magenta \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "selfplay": "vite-node docs/dev/scripts/selfplay.ts",
    "bench:optionb": "vite-node docs/dev/scripts/chargeAnchoredBench.ts",
    "cap:sync": "node -e \"require('child_process').execSync('npm run build',{stdio:'inherit',env:{...process.env,GC_NO_PWA:'1'}})\" && cap sync android",
    "apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "apk:offline": "npm run cap:sync && cd android && gradlew.bat assembleDebug --offline",
    "apk:copy": "npm run apk:offline && node -e \"require('fs').copyFileSync('android/app/build/outputs/apk/debug/app-debug.apk', require('os').homedir()+'/Downloads/GridlockChess-latest.apk'); console.log('APK -> Downloads/GridlockChess-latest.apk')\"",
    "android:open": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/share": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@mdx-js/react": "^3.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "fairy-stockfish-nnue.wasm": "^1.1.11",
    "ffish": "^0.7.9",
    "firebase": "^12.16.0",
    "framer-motion": "^12.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.28.0",
    "@mdx-js/rollup": "^3.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "rollup-plugin-license": "^3.7.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  }
}
